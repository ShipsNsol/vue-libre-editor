{
  "name": "vue-libre-editor",
  "version": "1.0.15",
  "description": "A free WYSIWYG editor for Vue.js",
  "author": "ShipsNsol",
  "license": "MIT",
  "type": "module",
  "main": "dist/vue-libre-editor.umd.js",
  "module": "dist/vue-libre-editor.es.js",
  "exports": {
    ".": {
      "import": "./dist/vue-libre-editor.es.js",
      "require": "./dist/vue-libre-editor.umd.js"
    },
    "./dist/vue-libre-editor.css": "./dist/vue-libre-editor.css",
    "./dist/style.css": "./dist/vue-libre-editor.css",
    "./lib/generate": "./src/lib/generate.js"
  },
  "files": [
    "dist",
    "src/lib"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0",
    "vue": "^3.3.4"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.511.0",
    "radix-vue": "^1.9.17",
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^20.3.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "postcss-prefixwrap": "^1.57.2",
    "tailwindcss": "^4.0.0",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^6.3.5"
  },
  "keywords": [
    "vue",
    "wysiwyg",
    "editor",
    "rich-text",
    "html-editor"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ShipsNsol/vue-libre-editor"
  },
  "bugs": {
    "url": "https://github.com/ShipsNsol/vue-libre-editor/issues"
  },
  "homepage": "https://github.com/ShipsNsol/vue-libre-editor"
}
